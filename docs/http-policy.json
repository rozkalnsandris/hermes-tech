{
  "schema_version": 2,
  "cache_control": {
    "fingerprinted_css": "public, max-age=31536000, immutable",
    "html": "no-cache",
    "stable_metadata": "no-cache"
  },
  "security_headers": {
    "Content-Security-Policy": "default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self'; style-src 'self'; script-src 'none'; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; manifest-src 'self'",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff"
  },
  "edge_transport": {
    "owner": "cloudflare_edge",
    "hostname": "tech.rozkalns.net",
    "https_redirect": {
      "required": true,
      "scope": "hostname",
      "source_scheme": "http",
      "target_scheme": "https",
      "status_code": 301,
      "preserve_path": true,
      "preserve_query_string": true
    },
    "hsts": {
      "required": true,
      "https_only": true,
      "header_name": "Strict-Transport-Security",
      "header_value": "max-age=15552000",
      "max_age_seconds": 15552000,
      "include_subdomains": false,
      "preload": false
    }
  },
  "stable_metadata_paths": [
    "/index.xml",
    "/robots.txt",
    "/llms.txt",
    "/site-v15.webmanifest"
  ]
}
