#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 077
PATH='/home/andris/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

[[ ${EUID:-$(id -u)} -ne 0 ]] || fail 'pull deploy must run as the unprivileged andris user'

REPO='rozkalnsandris/hermes-tech'
PRIMARY='/home/andris/hermes-tech'
SOURCE='/home/andris/hermes-tech-worktrees/release-control'
STATE_ROOT='/home/andris/.local/state/hermes-tech-main-deploy'
EVIDENCE_ROOT="$STATE_ROOT/evidence"
CONTROL_APPROVAL="$STATE_ROOT/approved-control-plane-sha"
INSTALLED_CONTROL_PLANE="$STATE_ROOT/installed-control-plane-sha"
LOCK_FILE="$STATE_ROOT/poll.lock"
PUBLISH_LOCK="$PRIMARY/.publish.lock"
HELPER='/usr/local/sbin/hermes-tech-deploy-main'
CLASSIFIER='/usr/local/libexec/hermes-tech/classify-deploy-impact'
READINESS='/usr/local/libexec/hermes-tech/deploy-readiness'

for command_name in date flock gh git install python3 rm sudo tr; do
    command -v "$command_name" >/dev/null 2>&1 || fail "required command is missing: $command_name"
done
for installed_helper in "$HELPER" "$CLASSIFIER" "$READINESS"; do
    [[ -x "$installed_helper" && ! -L "$installed_helper" ]] \
        || fail "installed control-plane helper is missing or unsafe: $installed_helper"
done
[[ -d "$PRIMARY" && ! -L "$PRIMARY" ]] || fail 'production root is missing or unsafe'
[[ -d "$SOURCE" && ! -L "$SOURCE" ]] || fail 'release-control worktree is missing or unsafe'

gh auth status --hostname github.com >/dev/null 2>&1 || fail 'GitHub CLI authentication is unavailable'
install -d -m 0700 "$STATE_ROOT" "$EVIDENCE_ROOT"
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    printf 'PULL_DEPLOY_RESULT=NO_OP_BUSY\n'
    exit 0
fi

record_readiness() {
    local reason=$1
    local target_sha=$2
    local production_sha=$3
    local deploy_impact=$4
    if ! "$READINESS" record \
        --state-root "$STATE_ROOT" \
        --env-file "$PRIMARY/.env" \
        --reason "$reason" \
        --deploy-impact "$deploy_impact" \
        --target-sha "$target_sha" \
        --production-sha "$production_sha"; then
        printf 'WARNING: deploy readiness state/notification update failed\n' >&2
    fi
}

classify_range() {
    local base_sha=$1
    local target_sha=$2
    (
        cd "$SOURCE"
        "$CLASSIFIER" --base "$base_sha" --target "$target_sha" --json
    )
}

parse_impact() {
    python3 -c '
import json, sys
payload = json.load(sys.stdin)
classification = payload.get("classification")
control = payload.get("control_plane_changed")
if not isinstance(classification, str) or not isinstance(control, bool):
    raise SystemExit("invalid deploy-impact payload")
print(classification)
print("true" if control else "false")
'
}

# The production publisher and the root deploy helper already serialize checkout
# mutation through .publish.lock. Take the same lock while capturing the poller's
# target/production snapshot so a scheduled poll cannot observe the publisher
# halfway between advancing production HEAD and pushing the generated commit.
# If a publication owns the lock, defer this poll without changing readiness.
[[ ! -L "$PUBLISH_LOCK" ]] || fail 'publish lock path is unsafe'
exec 8>"$PUBLISH_LOCK"
if ! flock -n 8; then
    printf 'PULL_DEPLOY_RESULT=NO_OP_PUBLISH_BUSY\n'
    exit 0
fi

git -C "$SOURCE" fetch --prune origin main
[[ -z "$(git -C "$SOURCE" branch --show-current)" ]] || fail 'release-control worktree must remain detached'
[[ -z "$(git -C "$SOURCE" status --porcelain=v1 --untracked-files=all)" ]] \
    || fail 'release-control worktree is not clean'
[[ "$(git -C "$PRIMARY" branch --show-current)" == 'main' ]] || fail 'production checkout must remain on main'

TARGET_SHA=$(git -C "$SOURCE" rev-parse refs/remotes/origin/main)
PRODUCTION_SHA=$(git -C "$PRIMARY" rev-parse HEAD)
[[ "$TARGET_SHA" =~ ^[0-9a-f]{40}$ ]] || fail 'origin/main SHA is invalid'
[[ "$PRODUCTION_SHA" =~ ^[0-9a-f]{40}$ ]] || fail 'production SHA is invalid'

INSTALLED_SHA=''
if [[ -f "$INSTALLED_CONTROL_PLANE" && ! -L "$INSTALLED_CONTROL_PLANE" ]]; then
    INSTALLED_SHA=$(tr -d '[:space:]' < "$INSTALLED_CONTROL_PLANE")
fi
[[ "$INSTALLED_SHA" =~ ^[0-9a-f]{40}$ ]] || fail 'installed control-plane SHA is missing or invalid'
git -C "$SOURCE" cat-file -e "${TARGET_SHA}^{commit}" || fail 'target SHA is not locally available'
git -C "$SOURCE" cat-file -e "${PRODUCTION_SHA}^{commit}" || fail 'production SHA is not locally available'
git -C "$SOURCE" cat-file -e "${INSTALLED_SHA}^{commit}" || fail 'installed control-plane SHA is not locally available'

# Production can already be at target after an explicitly authorized manual
# runtime rollout while the installed poller/service still come from an older
# control plane. Detect that gap instead of declaring the host publish-ready.
if [[ "$TARGET_SHA" == "$PRODUCTION_SHA" ]]; then
    INSTALLED_IMPACT_JSON=$(classify_range "$INSTALLED_SHA" "$TARGET_SHA") \
        || fail 'cannot classify installed control plane against current main'
    mapfile -t installed_impact < <(parse_impact <<<"$INSTALLED_IMPACT_JSON")
    [[ ${#installed_impact[@]} -eq 2 ]] || fail 'invalid installed control-plane classification output'
    if [[ "${installed_impact[1]}" == true ]]; then
        record_readiness \
            'WAIT_CONTROL_PLANE_APPROVAL' \
            "$TARGET_SHA" \
            "$PRODUCTION_SHA" \
            "${installed_impact[0]}"
        printf 'PULL_DEPLOY_RESULT=WAIT_CONTROL_PLANE_APPROVAL\n'
        printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
        printf 'INSTALLED_CONTROL_PLANE_SHA=%s\n' "$INSTALLED_SHA"
        exit 0
    fi
    record_readiness 'CURRENT' "$TARGET_SHA" "$PRODUCTION_SHA" 'NO_DEPLOY'
    printf 'PULL_DEPLOY_RESULT=NO_OP_ALREADY_CURRENT\n'
    printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
    exit 0
fi

git -C "$SOURCE" merge-base --is-ancestor "$PRODUCTION_SHA" "$TARGET_SHA" || {
    record_readiness 'DEPLOY_FAILED' "$TARGET_SHA" "$PRODUCTION_SHA" 'UNCLASSIFIED'
    fail 'production SHA is not an ancestor of current origin/main'
}

# From this point the coherent snapshot proves that production is genuinely
# behind current main. A publisher cannot validly mutate this checkout until the
# normal publication preflight sees production current again, so the short
# snapshot lock is no longer needed. The root deploy helper reacquires the same
# lock immediately before any production mutation.
flock -u 8

IMPACT_JSON=$(classify_range "$PRODUCTION_SHA" "$TARGET_SHA") \
    || fail 'cannot classify production-to-main deploy impact'
mapfile -t impact < <(parse_impact <<<"$IMPACT_JSON")
[[ ${#impact[@]} -eq 2 ]] || fail 'invalid deploy-impact classification output'
DEPLOY_IMPACT=${impact[0]}
CONTROL_PLANE_CHANGED=${impact[1]}
printf 'DEPLOY_IMPACT=%s\n' "$DEPLOY_IMPACT"
printf 'CONTROL_PLANE_CHANGED=%s\n' "$CONTROL_PLANE_CHANGED"

case "$DEPLOY_IMPACT" in
    DB_APPLY_REQUIRES_SEPARATE_APPROVAL)
        record_readiness \
            'DB_APPLY_REQUIRES_SEPARATE_APPROVAL' \
            "$TARGET_SHA" \
            "$PRODUCTION_SHA" \
            "$DEPLOY_IMPACT"
        printf 'PULL_DEPLOY_RESULT=DB_APPLY_REQUIRES_SEPARATE_APPROVAL\n'
        printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
        exit 0
        ;;
    RUNTIME_ROLLOUT_REQUIRED)
        record_readiness \
            'RUNTIME_ROLLOUT_REQUIRED' \
            "$TARGET_SHA" \
            "$PRODUCTION_SHA" \
            "$DEPLOY_IMPACT"
        printf 'PULL_DEPLOY_RESULT=RUNTIME_ROLLOUT_REQUIRED\n'
        printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
        exit 0
        ;;
    CONTROL_PLANE_APPROVAL_REQUIRED|AUTO_DEPLOY_SAFE|NO_DEPLOY)
        ;;
    *)
        record_readiness 'DEPLOY_FAILED' "$TARGET_SHA" "$PRODUCTION_SHA" "$DEPLOY_IMPACT"
        fail "unsupported deploy impact: $DEPLOY_IMPACT"
        ;;
esac

if [[ "$CONTROL_PLANE_CHANGED" == true ]]; then
    APPROVED_SHA=''
    if [[ -f "$CONTROL_APPROVAL" && ! -L "$CONTROL_APPROVAL" ]]; then
        APPROVED_SHA=$(tr -d '[:space:]' < "$CONTROL_APPROVAL")
    fi
    if [[ "$APPROVED_SHA" != "$TARGET_SHA" ]]; then
        record_readiness \
            'WAIT_CONTROL_PLANE_APPROVAL' \
            "$TARGET_SHA" \
            "$PRODUCTION_SHA" \
            "$DEPLOY_IMPACT"
        printf 'PULL_DEPLOY_RESULT=WAIT_CONTROL_PLANE_APPROVAL\n'
        printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
        exit 0
    fi
fi

RUNS_JSON=$(gh api \
    -H 'Accept: application/vnd.github+json' \
    "repos/$REPO/actions/workflows/ci.yml/runs?branch=main&head_sha=$TARGET_SHA&status=completed&per_page=100")
CI_RUN_ID=$(python3 -c '
import json, sys
sha = sys.argv[1]
data = json.load(sys.stdin)
runs = [
    row for row in data.get("workflow_runs", [])
    if row.get("event") in {"push", "workflow_dispatch"}
    and row.get("head_branch") == "main"
    and row.get("head_sha") == sha
    and row.get("status") == "completed"
    and row.get("conclusion") == "success"
]
print(max((int(row["id"]) for row in runs), default=""))
' "$TARGET_SHA" <<<"$RUNS_JSON")

if [[ -z "$CI_RUN_ID" ]]; then
    record_readiness 'WAIT_CI' "$TARGET_SHA" "$PRODUCTION_SHA" "$DEPLOY_IMPACT"
    printf 'PULL_DEPLOY_RESULT=WAIT_CI\n'
    printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
    exit 0
fi

JOBS_JSON=$(gh api \
    -H 'Accept: application/vnd.github+json' \
    "repos/$REPO/actions/runs/$CI_RUN_ID/jobs?filter=latest&per_page=100")
python3 -c '
import json, sys
jobs = json.load(sys.stdin).get("jobs", [])
validate = [row for row in jobs if row.get("name") == "validate"]
if len(validate) != 1:
    raise SystemExit(f"expected exactly one validate job, observed={len(validate)}")
job = validate[0]
if job.get("status") != "completed" or job.get("conclusion") != "success":
    raise SystemExit("validate job is not completed/success")
' <<<"$JOBS_JSON" || {
    record_readiness 'WAIT_CI' "$TARGET_SHA" "$PRODUCTION_SHA" "$DEPLOY_IMPACT"
    fail 'successful exact-SHA CI does not contain exactly one successful validate job'
}

STAMP=$(date -u +%Y%m%dT%H%M%SZ)
EVIDENCE_DIR="$EVIDENCE_ROOT/deploy-$TARGET_SHA-$STAMP-$$"
install -d -m 0700 "$EVIDENCE_DIR"
printf 'TARGET_SHA=%s\nCI_RUN_ID=%s\nCONTROL_PLANE_CHANGED=%s\nDEPLOY_IMPACT=%s\n' \
    "$TARGET_SHA" "$CI_RUN_ID" "$CONTROL_PLANE_CHANGED" "$DEPLOY_IMPACT" \
    >"$EVIDENCE_DIR/preflight.env"
chmod 0600 "$EVIDENCE_DIR/preflight.env"

if ! sudo --non-interactive "$HELPER" "$TARGET_SHA" "$EVIDENCE_DIR"; then
    record_readiness 'DEPLOY_FAILED' "$TARGET_SHA" "$PRODUCTION_SHA" "$DEPLOY_IMPACT"
    fail 'root deploy helper failed'
fi

if [[ "$CONTROL_PLANE_CHANGED" == true && -f "$CONTROL_APPROVAL" ]]; then
    APPROVED_SHA=$(tr -d '[:space:]' < "$CONTROL_APPROVAL")
    if [[ "$APPROVED_SHA" == "$TARGET_SHA" ]]; then
        rm -f -- "$CONTROL_APPROVAL"
    fi
fi

record_readiness 'CURRENT' "$TARGET_SHA" "$TARGET_SHA" 'NO_DEPLOY'
printf 'PULL_DEPLOY_RESULT=PASS\n'
printf 'TARGET_SHA=%s\n' "$TARGET_SHA"
printf 'CI_RUN_ID=%s\n' "$CI_RUN_ID"
printf 'EVIDENCE_DIR=%s\n' "$EVIDENCE_DIR"
