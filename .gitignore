/.local-backups/
/backups/
digest.py.backup-*
publish.sh.backup-*
/evidence/
/*.evidence.json
/*-evidence-*.json
/*-evidence-*.tar.gz
/*.tar.gz.sha256
/*.bundle
/*.bundle.*
*.tmp
*.swp
*~

# Generated Hugo state and output
/site/public/
/site/.hugo_build.lock
/site/resources/
/site/.hugo_cache/
/.hugo_cache/
