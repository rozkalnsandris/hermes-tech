# Local Python/runtime state
venv/
data/
logs/
.env
__pycache__/
*.py[cod]
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Runtime locks and temporary work directories
/.deploy.lock
/.publish.lock
/.publish-work.*
/.collector.lock
/.digest-pipeline.lock
